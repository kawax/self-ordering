{
    "name": "revolution/self-ordering",
    "description": "Self Ordering System",
    "keywords": [
        "laravel",
        "self-order",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "google/apiclient": "^2.15",
        "revolution/laravel-boost-copilot-cli": "^2.1"
    },
    "suggest": {
        "revolution/laravel-paypay": "PayPay Payment Driver"
    },
    "autoload": {
        "psr-4": {
            "Revolution\\Ordering\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "kawax",
            "email": "kawaxbiz@gmail.com"
        }
    ],
    "scripts": {
        "lint": "vendor/bin/pint --parallel",
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@build"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "boost": "vendor/bin/testbench boost:install --no-interaction --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Revolution\\Ordering\\Providers\\OrderingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
